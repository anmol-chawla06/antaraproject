# Antara festival Telegram bot configuration.
# Copy to .env and fill in. Never commit .env.
#
# Only needed to run bot.js. The three static front ends (index.html, map.html,
# library.html) need no environment configuration at all.

# From @BotFather on Telegram.
TELEGRAM_TOKEN=

# Google AI Studio key, used for the bot's conversational assistant.
GEMINI_API_KEY=
