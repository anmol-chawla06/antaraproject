# Antara server configuration.
# Copy to .env and fill in. Never commit .env.
# On Vercel these are set in Project Settings -> Environment Variables instead.
#
# Every variable below is read by the application. Nothing here is obsolete:
# the Telegram bot and its GEMINI_* / TELEGRAM_* variables were retired and
# removed, so they are deliberately absent.

# --- Heritage AI (OpenAI) ---
# Server-side only; the key never reaches the browser. Without it the app still
# starts and /api/chat answers 503 AI_UNCONFIGURED rather than crashing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Admin area: the contact inbox at /admin/messages/ ---
# Contact submissions contain personal information. If ADMIN_PASSWORD is empty
# the admin area is DISABLED entirely - there is no default credential, and
# every /admin route AND the sign-in endpoint answer 503 ADMIN_DISABLED.
# Set a password here, restart the server, then sign in at /admin-login.html.
ADMIN_PASSWORD=

# Signs admin session cookies (HMAC-SHA256).
#
# Locally: leave blank and a fresh random secret is generated per start, which
# simply signs you out on restart.
#
# On Vercel: SET THIS. Serverless runs many short-lived instances, so a
# per-process random secret means a session signed by one instance is rejected
# by the next - sign-in would appear to succeed and then immediately fail.
ADMIN_SESSION_SECRET=

# --- Contact storage ---
# PostgreSQL connection string for contact messages. Server-side only; it
# carries a password and must never reach the browser.
#
# Leave BLANK locally: with no value the server uses the JSON file store at
# landing-page/data/contact_messages.json, which is right for a single process
# on a real disk.
#
# SET THIS ON VERCEL. A serverless filesystem is read-only apart from /tmp, and
# /tmp is per-instance and evicted without warning, so without a database the
# contact form declines every message rather than losing it.
#
# Only contact messages live in this database. Heritage data, manuscripts,
# festivals, map data and media stay as files in the repository.
#
# If a Vercel Postgres integration injects POSTGRES_URL instead, that is read
# automatically and nothing needs to be set here.
DATABASE_URL=

# Shown to a visitor when the server cannot store their message, so they have
# somewhere real to write instead of being told to "try again later".
CONTACT_EMAIL=

# --- Server ---
# Local listener port. Vercel sets and routes its own port; this is ignored there.
PORT=8080

# Comma-separated origins allowed to call the API cross-origin.
# Same-origin browser requests need no entry here; leave blank for local use
# and for a single-domain Vercel deployment.
ALLOWED_ORIGINS=
