# Antara landing-page server configuration.
# Copy to .env and fill in. Never commit .env.

# --- Heritage AI (OpenAI) ---
# Without a key, /api/chat returns a clear "not configured" message and the
# Heritage AI panel says so rather than failing silently.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Admin area: the contact inbox at /admin/messages/ ---
# Contact submissions contain personal information. If ADMIN_PASSWORD is empty
# the admin area is DISABLED entirely - there is no default credential, and
# every /admin route AND the sign-in endpoint answer 503 ADMIN_DISABLED.
# Set a password here, restart the server, then sign in at /admin-login.html.
ADMIN_PASSWORD=

# Signs admin session cookies. Leave blank to generate a new random secret on
# every start (which signs admins out on restart). Set a value to keep sessions
# alive across restarts.
ADMIN_SESSION_SECRET=

# --- Server ---
PORT=8080

# Comma-separated origins allowed to call the API cross-origin.
# Same-origin browser requests need no entry here; leave blank for local use.
ALLOWED_ORIGINS=
